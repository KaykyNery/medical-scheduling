# NestJS specific gitignore

# Compiled output
/dist
/node_modules

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Test coverage
/coverage
*.lcov

# TypeScript cache
*.tsbuildinfo

# Env & Secrets
.env*
!.env.example
*.pem
*.key

# IDEs
.vscode/
.idea/
