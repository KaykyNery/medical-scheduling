# Medical Scheduling - Root gitignore

# Node dependencies
**/node_modules/
.pnp
.pnp.js

# Build and Output directories
/backend/dist/
/frontend/.next/
/frontend/out/
/frontend/build/
**/dist/
**/.next/
**/build/

# IDEs & Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.classpath
.project
.settings/

# Operating System Files
.DS_Store
.DS_Store?
ehthumbs.db
Icon?
Thumbs.db
[Dd]esktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
**/coverage/
.nyc_output/

# Env & Secrets (Never commit secrets/credentials to git!)
.env*
!.env.example
**/.env*
!**/.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*.id_ed25519

# Database dumps, sqlite & backups (excluding Prisma migration files)
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
*.backup
*.tmp

# Typescript build info
*.tsbuildinfo

# Cypress / Playwright test artifacts (if any)
**/cypress/videos/
**/cypress/screenshots/
**/playwright-report/
**/test-results/
