# Medical Scheduling - Root gitignore

# Node dependencies
**/node_modules/
.pnp
.pnp.js

# Build and Output directories
/backend/dist/
/frontend/.next/
/frontend/out/
/frontend/build/
**/dist/
**/.next/
**/build/

# IDEs & Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.classpath
.project
.settings/

# Operating System Files
.DS_Store
.DS_Store?
ehthumbs.db
Icon?
Thumbs.db
[Dd]esktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
**/coverage/
.nyc_output/

# Env & Secrets (Never commit secrets/credentials to git!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
*.pem
*.key

# Typescript build info
*.tsbuildinfo

# Cypress / Playwright test artifacts (if any)
**/cypress/videos/
**/cypress/screenshots/
**/playwright-report/
**/test-results/
